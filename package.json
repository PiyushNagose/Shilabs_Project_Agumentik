{
  "name": "shilabs-ai-sales-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "dotenv -e .env -- npm run dev -w @shilabs/web",
    "dev:api": "dotenv -e .env -- npm run dev -w @shilabs/api",
    "dev:worker": "dotenv -e .env -- npm run dev -w @shilabs/worker",
    "dev:e2e:web": "dotenv -o -e .env -e .env.e2e.local -- npm run dev -w @shilabs/web -- --port 5174",
    "dev:e2e:api": "dotenv -o -e .env -e .env.e2e.local -- npm run dev -w @shilabs/api",
    "dev:e2e:worker": "dotenv -o -e .env -e .env.e2e.local -- npm run dev -w @shilabs/worker",
    "build": "npm run build --workspaces --if-present",
    "type-check": "tsc -b && tsc -p apps/api/tsconfig.prisma.json --noEmit",
    "lint": "eslint \"apps/*/src/**/*.{ts,tsx}\" \"apps/api/prisma/**/*.ts\" \"packages/*/src/**/*.{ts,tsx}\"",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "node scripts/run-tests.cjs",
    "test:focused": "node scripts/run-tests.cjs",
    "db:generate": "dotenv -e .env -- npm run db:generate -w @shilabs/api",
    "db:migrate": "dotenv -e .env -- npm run db:migrate -w @shilabs/api",
    "db:deploy": "dotenv -e .env -- npm run db:deploy -w @shilabs/api",
    "db:seed": "dotenv -e .env -- npm run db:seed -w @shilabs/api",
    "db:reset": "dotenv -e .env -- npm run db:reset -w @shilabs/api"
  },
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "overrides": {
    "prisma": "6.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@testing-library/react": "^16.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^22.5.0",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.9.0",
    "happy-dom": "^20.14.0",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^7.0.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
