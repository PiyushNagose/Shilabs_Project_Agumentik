NODE_ENV=development

API_HOST=0.0.0.0
API_PORT=4000
WEB_PORT=5173
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:4000

DATABASE_URL=postgresql://shilabs:shilabs_dev_password@localhost:5433/shilabs_sales
REDIS_URL=redis://localhost:6380
DOMAIN_EVENT_QUEUE_NAME=domain-events
DOMAIN_EVENT_WORKER_CONCURRENCY=5
DOMAIN_EVENT_DISPATCH_LIMIT=25
DOMAIN_EVENT_DISPATCH_INTERVAL_MS=60000
DOMAIN_EVENT_STALE_AFTER_MS=900000

DEV_ADMIN_EMAIL=admin@example.local
DEV_ADMIN_PASSWORD=change-me-in-local-env

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
BCRYPT_SALT_ROUNDS=12

AI_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=1

SEMRUSH_API_KEY=
SEMRUSH_ENDPOINT=https://api.semrush.com/
SEMRUSH_DATABASE=us
SEMRUSH_TIMEOUT_MS=30000
SEMRUSH_MAX_RETRIES=1

ZOHO_BIGIN_CLIENT_ID=
ZOHO_BIGIN_CLIENT_SECRET=
ZOHO_BIGIN_REFRESH_TOKEN=
ZOHO_BIGIN_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_BIGIN_API_DOMAIN=https://www.zohoapis.com
ZOHO_BIGIN_REQUIRED_SCOPES=ZohoBigin.modules.ALL
ZOHO_BIGIN_TIMEOUT_MS=30000
ZOHO_BIGIN_MAX_RETRIES=1
ZOHO_BIGIN_TOKEN_SKEW_SECONDS=120
ZOHO_BIGIN_CONTACTS_MODULE=Contacts
ZOHO_BIGIN_DEALS_MODULE=Pipelines
ZOHO_BIGIN_TIMELINE_RELATED_MODULE=Contacts
ZOHO_BIGIN_SYNC_PER_PAGE=200
ZOHO_BIGIN_SYNC_MAX_PAGES=25

# Local development/demo email uses Mailpit by default. Production should set
# EMAIL_PROVIDER=AWS_SES and must not set ALLOW_EXTERNAL_EMAIL_IN_NON_PRODUCTION=true.
EMAIL_PROVIDER=MAILPIT
ALLOW_EXTERNAL_EMAIL_IN_NON_PRODUCTION=false
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_SMTP_SECURE=false
MAILPIT_FROM_EMAIL=sales@shilabs.local
MAILPIT_REPLY_TO_EMAIL=
MAILPIT_TIMEOUT_MS=10000
MAILPIT_HTTP_URL=http://localhost:8025

AWS_SES_REGION=
AWS_SES_FROM_EMAIL=
AWS_SES_REPLY_TO_EMAIL=
AWS_SES_CONFIGURATION_SET=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_USE_DEFAULT_CREDENTIAL_CHAIN=false
AWS_SES_WEBHOOK_SECRET=
AWS_SES_TIMEOUT_MS=30000
AWS_SES_MAX_RETRIES=1

# R24 Messaging / WhatsApp. Keep provider disabled until a real Meta WhatsApp
# Business app, phone number and approved template are configured. OC-08
# template/consent policy remains configurable and unresolved.
MESSAGING_PROVIDER=none
MESSAGING_WEBHOOK_BASE_URL=
MESSAGING_TIMEOUT_MS=30000
MESSAGING_MAX_RETRIES=1
WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com/v20.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_DEFAULT_TEMPLATE_NAME=
WHATSAPP_DEFAULT_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_POLICY_MODE=unresolved
WHATSAPP_E2E_ALLOWED_TO_NUMBERS=

# Calendar foundation. R20 only exposes health + availability contracts.
# Use CALENDAR_PROVIDER=none until a real provider adapter is configured.
CALENDAR_PROVIDER=none
CALENDAR_DEFAULT_TIME_ZONE=Asia/Kolkata
CALENDAR_WORKDAY_START=09:00
CALENDAR_WORKDAY_END=17:00
CALENDAR_SLOT_MINUTES=30
CALENDAR_LOOKAHEAD_DAYS=14
CALENDAR_TIMEOUT_MS=30000
CALENDAR_MAX_RETRIES=1

# Future local/E2E Google Calendar adapter credentials.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
# R20 availability requires calendar.freebusy. R21 meeting creation also requires calendar.events.
GOOGLE_CALENDAR_SCOPE=https://www.googleapis.com/auth/calendar.freebusy https://www.googleapis.com/auth/calendar.events

# Future Microsoft Graph Calendar adapter credentials.
MICROSOFT_CALENDAR_TENANT_ID=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_USER_ID=

# R22 Voice Provider Foundation. Keep disabled until a real provider account and
# verified local E2E destination number are configured.
VOICE_PROVIDER=none
VOICE_WEBHOOK_BASE_URL=
VOICE_DEFAULT_REGION=IN
VOICE_DEFAULT_ACCENT=indian-english
VOICE_RECORDING_ENABLED=false
VOICE_TRANSCRIPTION_ENABLED=false
VOICE_PRODUCTION_CALLING_ENABLED=false
VOICE_COMPLIANCE_CONSENT_MODE=disabled
VOICE_E2E_ALLOWED_TO_NUMBERS=
VOICE_TIMEOUT_MS=30000
VOICE_MAX_RETRIES=1

# R23 Calling Automation. Timing remains configurable while OC-01 voicemail and
# OC-13 compliance rules are unresolved.
CALLING_AUTOMATION_ENABLED=true
CALLING_AUTOMATION_ATTEMPTS_SAME_DAY=2
CALLING_AUTOMATION_SAME_DAY_SPACING_MINUTES=240
CALLING_AUTOMATION_WAIT_DAYS_AFTER_SAME_DAY=3
CALLING_AUTOMATION_MAX_ATTEMPTS=3

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_STATUS_CALLBACK_PATH=/api/voice/twilio/status
TWILIO_RECORDING_CALLBACK_PATH=/api/voice/twilio/recording
