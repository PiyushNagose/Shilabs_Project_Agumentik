NODE_ENV=development

API_HOST=0.0.0.0
API_PORT=4010
WEB_PORT=5174
WEB_ORIGIN=http://localhost:5174
VITE_API_BASE_URL=http://localhost:4010
WORKER_API_BASE_URL=http://localhost:4010
# Shared API/worker secret (32+ random characters). Required for fresh follow-up preparation
# and cross-process realtime delivery. Never expose this through a VITE_ variable.
REALTIME_INTERNAL_SECRET=
API_TRUST_PROXY=false
API_JSON_BODY_LIMIT=1mb
API_WEBHOOK_BODY_LIMIT=512kb
API_GLOBAL_RATE_LIMIT_WINDOW_MS=900000
API_GLOBAL_RATE_LIMIT_MAX=1000
API_WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
API_WEBHOOK_RATE_LIMIT_MAX=120

DATABASE_URL=postgresql://shilabs:shilabs_dev_password@localhost:5433/shilabs_sales
# Set a direct connection for migrations when DATABASE_URL uses a connection pooler.
DIRECT_DATABASE_URL=
# Required by DB-backed tests. Always point this at a disposable database, never DATABASE_URL.
TEST_DATABASE_URL=postgresql://shilabs:shilabs_test_password@localhost:5434/shilabs_sales_test
REDIS_URL=redis://localhost:6380
DOMAIN_EVENT_QUEUE_NAME=domain-events
DOMAIN_EVENT_WORKER_CONCURRENCY=5
DOMAIN_EVENT_DISPATCH_LIMIT=25
DOMAIN_EVENT_DISPATCH_INTERVAL_MS=60000
DOMAIN_EVENT_STALE_AFTER_MS=900000
DOMAIN_EVENT_QUEUED_STALE_AFTER_MS=120000
AI_AUTOSTART_ON_LEAD_CREATE=true

DEV_ADMIN_EMAIL=admin@example.local
DEV_ADMIN_PASSWORD=change-me-in-local-env
PRODUCTION_BOOTSTRAP_ADMIN_EMAIL=
PRODUCTION_BOOTSTRAP_ADMIN_PASSWORD=

JWT_SECRET=replace-with-at-least-32-random-characters
# Local/dev default: 7 days. Production can lower this per security policy.
JWT_ACCESS_TOKEN_TTL_SECONDS=604800
BCRYPT_SALT_ROUNDS=12
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_WEBHOOK_SECRET=
OPS_ALERT_TIMEOUT_MS=5000

AI_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=1

SEMRUSH_API_KEY=
SEMRUSH_ENDPOINT=https://api.semrush.com/
SEMRUSH_DATABASE=us
SEMRUSH_TIMEOUT_MS=30000
SEMRUSH_MAX_RETRIES=1

ZOHO_BIGIN_CLIENT_ID=
ZOHO_BIGIN_CLIENT_SECRET=
ZOHO_BIGIN_REFRESH_TOKEN=
ZOHO_BIGIN_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_BIGIN_API_DOMAIN=https://www.zohoapis.com
ZOHO_BIGIN_REQUIRED_SCOPES=ZohoBigin.modules.ALL
ZOHO_BIGIN_TIMEOUT_MS=30000
ZOHO_BIGIN_MAX_RETRIES=1
ZOHO_BIGIN_TOKEN_SKEW_SECONDS=120
ZOHO_BIGIN_CONTACTS_MODULE=Contacts
ZOHO_BIGIN_DEALS_MODULE=Pipelines
ZOHO_BIGIN_TIMELINE_RELATED_MODULE=Contacts
ZOHO_BIGIN_SYNC_PER_PAGE=200
ZOHO_BIGIN_SYNC_MAX_PAGES=25

# Local development/demo email uses Mailpit by default. Production should set
# EMAIL_PROVIDER=AWS_SES and must not set ALLOW_EXTERNAL_EMAIL_IN_NON_PRODUCTION=true.
EMAIL_PROVIDER=MAILPIT
ALLOW_EXTERNAL_EMAIL_IN_NON_PRODUCTION=false
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_SMTP_SECURE=false
MAILPIT_FROM_EMAIL=sales@shilabs.local
MAILPIT_REPLY_TO_EMAIL=
MAILPIT_TIMEOUT_MS=10000
MAILPIT_HTTP_URL=http://localhost:8025

AWS_SES_REGION=
AWS_SES_FROM_EMAIL=
AWS_SES_REPLY_TO_EMAIL=
AWS_SES_CONFIGURATION_SET=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_USE_DEFAULT_CREDENTIAL_CHAIN=false
AWS_SES_WEBHOOK_SECRET=
AWS_SES_INBOUND_TOPIC_ARN=
AWS_SES_INBOUND_BUCKET=
AWS_SES_INBOUND_KEY_PREFIX=inbound/
AWS_SES_TIMEOUT_MS=30000
AWS_SES_MAX_RETRIES=1

# R24 Messaging / WhatsApp. Keep provider disabled until a real Meta WhatsApp
# Business app or Twilio WhatsApp Sandbox is configured. OC-08 template/consent
# policy remains configurable and unresolved.
MESSAGING_PROVIDER=none
MESSAGING_WEBHOOK_BASE_URL=
MESSAGING_TIMEOUT_MS=30000
MESSAGING_MAX_RETRIES=1
WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com/v20.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_DEFAULT_TEMPLATE_NAME=
WHATSAPP_DEFAULT_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_POLICY_MODE=unresolved
WHATSAPP_E2E_ALLOWED_TO_NUMBERS=
TWILIO_WHATSAPP_ACCOUNT_SID=
TWILIO_WHATSAPP_AUTH_TOKEN=
TWILIO_WHATSAPP_SANDBOX_FROM=whatsapp:+14155238886
# Required by Twilio accounts that enforce WhatsApp Content Templates.
TWILIO_WHATSAPP_CONTENT_SID=
TWILIO_WHATSAPP_DEFAULT_BODY=Hello from Shilabs AI Sales Engine. Reply here and our team will follow up.

# Calendar and meeting provider. Keep disabled until one complete credential set is configured.
CALENDAR_PROVIDER=none
MEETING_CONFERENCE_PROVIDER=native
CALENDAR_DEFAULT_TIME_ZONE=Asia/Kolkata
CALENDAR_WORKDAY_START=09:00
CALENDAR_WORKDAY_END=17:00
CALENDAR_SLOT_MINUTES=30
CALENDAR_LOOKAHEAD_DAYS=14
CALENDAR_TIMEOUT_MS=30000
CALENDAR_MAX_RETRIES=1

# Google Calendar. Native conferencing creates a Google Meet link.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Register this exact callback URL in the Google OAuth web client.
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:4010/api/calendar/oauth/google/callback
# Required for in-app reconnect: 32 random bytes encoded as 64 hex characters. No default.
CALENDAR_OAUTH_ENCRYPTION_KEY=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
# R20 availability requires calendar.freebusy. R21 meeting creation also requires calendar.events.
GOOGLE_CALENDAR_SCOPE=https://www.googleapis.com/auth/calendar.freebusy https://www.googleapis.com/auth/calendar.events

# Microsoft Graph Calendar. Native conferencing creates a Microsoft Teams link.
# Azure app permissions: Calendars.ReadWrite (application), with admin consent.
MICROSOFT_CALENDAR_TENANT_ID=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_USER_ID=

# Optional Zoom Server-to-Server OAuth conferencing. Set
# MEETING_CONFERENCE_PROVIDER=zoom to create a verified Zoom meeting and attach it
# to the selected Google or Microsoft calendar event.
# Zoom app scopes: meeting:write:admin (or meeting:write for the configured host).
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_USER_ID=me

# R22 Voice Provider Foundation. Keep disabled until a real provider account and
# verified local E2E destination number are configured.
VOICE_PROVIDER=none
VOICE_WEBHOOK_BASE_URL=
VOICE_DEFAULT_REGION=IN
VOICE_DEFAULT_ACCENT=indian-english
VOICE_RECORDING_ENABLED=false
VOICE_TRANSCRIPTION_ENABLED=false
VOICE_PRODUCTION_CALLING_ENABLED=false
VOICE_COMPLIANCE_CONSENT_MODE=disabled
VOICE_E2E_ALLOWED_TO_NUMBERS=
VOICE_TIMEOUT_MS=30000
VOICE_MAX_RETRIES=1

# R23 Calling Automation. Timing remains configurable while OC-01 voicemail and
# OC-13 compliance rules are unresolved.
CALLING_AUTOMATION_ENABLED=true
CALLING_AUTOMATION_ATTEMPTS_SAME_DAY=2
CALLING_AUTOMATION_SAME_DAY_SPACING_MINUTES=240
CALLING_AUTOMATION_WAIT_DAYS_AFTER_SAME_DAY=3
CALLING_AUTOMATION_MAX_ATTEMPTS=3

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_STATUS_CALLBACK_PATH=/api/voice/twilio/status
TWILIO_RECORDING_CALLBACK_PATH=/api/voice/twilio/recording

EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_API_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=
EXOTEL_APP_URL=
EXOTEL_AGENT_NUMBER=
EXOTEL_STATUS_CALLBACK_PATH=/api/voice/exotel/status
EXOTEL_VOICEBOT_APP_PATH=/api/voice/exotel/voicebot
EXOTEL_VOICEBOT_STREAM_PATH=/api/voice/exotel/voicebot/stream
# Separate callback credential appended only to provider callback URLs. Do not reuse API tokens.
EXOTEL_WEBHOOK_SECRET=

# R22/R23 Voice AI. Keep disabled until the streaming provider, token and
# telephony callback URLs are configured and tested end-to-end.
VOICE_AI_ENABLED=false
VOICE_AI_PROVIDER=openai_realtime
VOICE_AI_OPENAI_API_KEY=
VOICE_AI_OPENAI_MODEL=gpt-realtime
VOICE_AI_OPENAI_VOICE=alloy
VOICE_AI_AUDIO_SAMPLE_RATE=16000
VOICE_AI_STREAM_TOKEN=
VOICE_AI_STREAM_TOKEN_TTL_SECONDS=300
VOICE_AI_LOCAL_VOSK_MODEL_PATH=
VOICE_AI_LOCAL_PYTHON_COMMAND=python
VOICE_AI_LOCAL_TTS_VOICE_NAME=

# Internal escalation email. Uses existing EMAIL_PROVIDER and SES/Mailpit configuration.
NOTIFICATION_ESCALATION_ENABLED=false
NOTIFICATION_ESCALATION_MAX_ATTEMPTS=5

# Optional shared realtime relay. API instances must use the same Redis channel.
REALTIME_REDIS_URL=
REALTIME_REDIS_CHANNEL=shilabs:realtime:v1

# Local Tesseract OCR. Only language assets are downloaded; documents stay local.
# Set OCR_LANG_PATH to a local directory containing eng.traineddata.gz for offline use.
# For uncompressed .traineddata files, set OCR_LANG_GZIP=false.
OCR_LANGUAGE=eng
OCR_LANG_PATH=
OCR_LANG_GZIP=true
# Whole PDF extraction deadline; capped at 180000 ms.
OCR_TIMEOUT_MS=120000
