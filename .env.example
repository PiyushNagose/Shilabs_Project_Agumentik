NODE_ENV=development

API_HOST=0.0.0.0
API_PORT=4000
WEB_PORT=5173
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:4000

DATABASE_URL=postgresql://shilabs:shilabs_dev_password@localhost:5433/shilabs_sales
REDIS_URL=redis://localhost:6380
DOMAIN_EVENT_QUEUE_NAME=domain-events
DOMAIN_EVENT_WORKER_CONCURRENCY=5
DOMAIN_EVENT_DISPATCH_LIMIT=25
DOMAIN_EVENT_DISPATCH_INTERVAL_MS=60000
DOMAIN_EVENT_STALE_AFTER_MS=900000

DEV_ADMIN_EMAIL=admin@example.local
DEV_ADMIN_PASSWORD=change-me-in-local-env

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
BCRYPT_SALT_ROUNDS=12

AI_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=1

SEMRUSH_API_KEY=
SEMRUSH_ENDPOINT=https://api.semrush.com/
SEMRUSH_DATABASE=us
SEMRUSH_TIMEOUT_MS=30000
SEMRUSH_MAX_RETRIES=1

ZOHO_BIGIN_CLIENT_ID=
ZOHO_BIGIN_CLIENT_SECRET=
ZOHO_BIGIN_REFRESH_TOKEN=
ZOHO_BIGIN_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_BIGIN_API_DOMAIN=https://www.zohoapis.com
ZOHO_BIGIN_REQUIRED_SCOPES=ZohoBigin.modules.ALL
ZOHO_BIGIN_TIMEOUT_MS=30000
ZOHO_BIGIN_MAX_RETRIES=1
ZOHO_BIGIN_TOKEN_SKEW_SECONDS=120
ZOHO_BIGIN_CONTACTS_MODULE=Contacts
ZOHO_BIGIN_DEALS_MODULE=Pipelines
ZOHO_BIGIN_TIMELINE_RELATED_MODULE=Contacts
ZOHO_BIGIN_SYNC_PER_PAGE=200
ZOHO_BIGIN_SYNC_MAX_PAGES=25

# Local development/demo email uses Mailpit by default. Production should set
# EMAIL_PROVIDER=AWS_SES and must not set ALLOW_EXTERNAL_EMAIL_IN_NON_PRODUCTION=true.
EMAIL_PROVIDER=MAILPIT
ALLOW_EXTERNAL_EMAIL_IN_NON_PRODUCTION=false
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_SMTP_SECURE=false
MAILPIT_FROM_EMAIL=sales@shilabs.local
MAILPIT_REPLY_TO_EMAIL=
MAILPIT_TIMEOUT_MS=10000
MAILPIT_HTTP_URL=http://localhost:8025

AWS_SES_REGION=
AWS_SES_FROM_EMAIL=
AWS_SES_REPLY_TO_EMAIL=
AWS_SES_CONFIGURATION_SET=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_USE_DEFAULT_CREDENTIAL_CHAIN=false
AWS_SES_WEBHOOK_SECRET=
AWS_SES_TIMEOUT_MS=30000
AWS_SES_MAX_RETRIES=1

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

CALENDAR_PROVIDER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
