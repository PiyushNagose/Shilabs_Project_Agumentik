{
  "name": "@shilabs/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -b",
    "type-check": "tsc -b --pretty false",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1132.0",
    "@prisma/client": "6.12.0",
    "@shilabs/shared-config": "0.0.0",
    "@shilabs/shared-types": "0.0.0",
    "@shilabs/validation": "0.0.0",
    "@types/ws": "^8.18.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jose": "^6.2.12",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.0.10",
    "ws": "^8.22.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "prisma": "6.12.0",
    "tsx": "^4.19.0"
  }
}
