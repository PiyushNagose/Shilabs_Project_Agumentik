model ExternalRecordMapping {
  id                   String                   @id @default(cuid())
  workspaceId          String?
  integrationAccountId String?
  provider             IntegrationProvider
  entityType           ExternalRecordEntityType
  localEntityId        String
  externalRecordId     String
  externalVersion      String?
  externalUpdatedAt    DateTime?
  lastSyncedAt         DateTime?
  syncDirection        SyncDirection            @default(BIDIRECTIONAL)
  syncStatus           SyncStatus               @default(PENDING)
  lastErrorCode        String?
  lastErrorMessage     String?
  retryCount           Int                      @default(0)
  idempotencyKey       String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  integrationAccount IntegrationAccount? @relation(fields: [integrationAccountId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, provider, entityType, localEntityId], map: "ExternalRecordMapping_workspaceId_provider_entityType_localEnti")
  @@unique([workspaceId, provider, entityType, externalRecordId], map: "ExternalRecordMapping_workspaceId_provider_entityType_externalR")
  @@unique([workspaceId, provider, idempotencyKey])
  @@index([integrationAccountId])
  @@index([provider, entityType])
  @@index([syncStatus])
  @@index([lastSyncedAt])
  @@index([externalUpdatedAt])
}

