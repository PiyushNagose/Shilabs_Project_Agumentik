generator client {
  provider = "prisma-client-js"
}

generator workerClient {
  provider = "prisma-client-js"
  output   = "../../worker/node_modules/@prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

