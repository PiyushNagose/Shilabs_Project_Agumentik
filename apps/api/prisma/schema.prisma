model AgentCorrection {
  id                      String                    @id @default(cuid())
  agentModule             String
  sourceEntityType        AgentCorrectionSourceType
  sourceEntityId          String
  leadId                  String?
  proposalId              String?
  conversationId          String?
  proposalGenerationRunId String?
  replyProcessingRunId    String?
  previousOutput          Json
  correctedOutcome        Json
  correctionSummary       String
  status                  AgentCorrectionStatus     @default(ACTIVE)
  version                 Int                       @default(1)
  supersedesCorrectionId  String?
  correctedByUserId       String
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  lead                  Lead?                  @relation(fields: [leadId], references: [id], onDelete: SetNull)
  proposal              Proposal?              @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  conversation          Conversation?          @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  proposalGenerationRun ProposalGenerationRun? @relation(fields: [proposalGenerationRunId], references: [id], onDelete: SetNull)
  replyProcessingRun    ReplyProcessingRun?    @relation(fields: [replyProcessingRunId], references: [id], onDelete: SetNull)
  supersedesCorrection  AgentCorrection?       @relation("AgentCorrectionHistory", fields: [supersedesCorrectionId], references: [id], onDelete: SetNull)
  supersededBy          AgentCorrection[]      @relation("AgentCorrectionHistory")
  correctedBy           User                   @relation("AgentCorrectionCorrectedBy", fields: [correctedByUserId], references: [id], onDelete: Restrict)

  @@index([agentModule])
  @@index([sourceEntityType, sourceEntityId])
  @@index([leadId])
  @@index([proposalId])
  @@index([conversationId])
  @@index([proposalGenerationRunId])
  @@index([replyProcessingRunId])
  @@index([status])
  @@index([correctedByUserId])
  @@index([createdAt])
}
