model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  ownedLeads                  Lead[]                    @relation("LeadOwner")
  scoreOverrideLeads          Lead[]                    @relation("LeadScoreOverrideBy")
  ownedDeals                  Deal[]                    @relation("DealOwner")
  activities                  Activity[]
  messages                    Message[]
  authSessions                AuthSession[]
  IntegrationSyncRun          IntegrationSyncRun[]
  outboundEmails              OutboundEmail[]
  emailSuppressions           EmailSuppression[]
  emailDeliverabilityScans    EmailDeliverabilityScan[]
  leadScoreRuns               LeadScoreRun[]
  createdKnowledgeEntries     KnowledgeBaseEntry[]      @relation("KnowledgeEntryCreatedBy")
  updatedKnowledgeEntries     KnowledgeBaseEntry[]      @relation("KnowledgeEntryUpdatedBy")
  createdKnowledgeVersions    KnowledgeBaseVersion[]    @relation("KnowledgeVersionCreatedBy")
  approvedKnowledgeVersions   KnowledgeBaseVersion[]    @relation("KnowledgeVersionApprovedBy")
  requestedDomainEventRetries DomainEventOutbox[]       @relation("DomainEventRetryRequestedBy")
  createdProposals            Proposal[]                @relation("ProposalCreatedBy")
  approvedProposals           Proposal[]                @relation("ProposalApprovedBy")
  sentProposals               Proposal[]                @relation("ProposalSentBy")
  createdProposalVersions     ProposalVersion[]         @relation("ProposalVersionCreatedBy")
  proposalStatusChanges       ProposalStatusChange[]    @relation("ProposalStatusChangeActor")
  proposalGenerationRuns      ProposalGenerationRun[]   @relation("ProposalGenerationActor")
  agentCorrections            AgentCorrection[]         @relation("AgentCorrectionCorrectedBy")
  humanTakeovers              HumanTakeover[]           @relation("HumanTakeoverActor")
  negotiationHandoffs         NegotiationHandoff[]      @relation("NegotiationHandoffAssignee")
  assignedNotifications       InternalNotification[]    @relation("InternalNotificationAssignee")
  readNotifications           InternalNotification[]    @relation("InternalNotificationReadBy")
  acknowledgedNotifications   InternalNotification[]    @relation("InternalNotificationAcknowledgedBy")
  escalatedNotifications      InternalNotification[]    @relation("InternalNotificationEscalatedBy")
  ownedMeetingRequests        MeetingRequest[]          @relation("MeetingRequestOwner")
  requestedMeetingRequests    MeetingRequest[]          @relation("MeetingRequestRequestedBy")
  confirmedMeetingRequests    MeetingRequest[]          @relation("MeetingRequestConfirmedBy")
  voiceCallAttempts           VoiceCallAttempt[]        @relation("VoiceCallActor")
  briefingRuns                BriefingRun[]             @relation("BriefingRunActor")
  workspaceMemberships        WorkspaceMember[]
  assignedTasks               Task[]                    @relation("TaskAssignee")
  createdTasks                Task[]                    @relation("TaskCreatedByUser")
  completedTasks              Task[]                    @relation("TaskCompletedByUser")
  createdAgents               Agent[]                   @relation("AgentCreatedBy")
  publishedAgentVersions      AgentVersion[]            @relation("AgentVersionPublishedBy")

  @@index([role])
  @@index([status])
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  status      String   @default("ACTIVE")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members   WorkspaceMember[]
  tasks     Task[]
  pipelines Pipeline[]
  agents    Agent[]

  @@index([status])
}

model Agent {
  id               String      @id @default(cuid())
  workspaceId      String
  key              String
  name             String
  description      String
  type             AgentType
  status           AgentStatus @default(DRAFT)
  currentVersionId String?
  createdByUserId  String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy      User?            @relation("AgentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  currentVersion AgentVersion?    @relation("AgentCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       AgentVersion[]   @relation("AgentVersions")
  executions     AgentExecution[]

  @@unique([workspaceId, key])
  @@index([workspaceId, type])
  @@index([workspaceId, status])
  @@index([currentVersionId])
}

model AgentVersion {
  id                String    @id @default(cuid())
  agentId           String
  version           Int
  definition        Json
  modelConfig       Json?
  toolsConfig       Json?
  knowledgeConfig   Json?
  publishedAt       DateTime?
  publishedByUserId String?
  createdAt         DateTime  @default(now())

  agent       Agent            @relation("AgentVersions", fields: [agentId], references: [id], onDelete: Cascade)
  currentFor  Agent[]          @relation("AgentCurrentVersion")
  publishedBy User?            @relation("AgentVersionPublishedBy", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  executions  AgentExecution[]

  @@unique([agentId, version])
  @@index([agentId, createdAt])
  @@index([publishedByUserId])
}

model AgentExecution {
  id               String               @id @default(cuid())
  workspaceId      String
  agentId          String
  versionId        String
  source           String
  sourceEntityType String?
  sourceEntityId   String?
  entityType       String?
  entityId         String?
  leadId           String?
  status           AgentExecutionStatus @default(QUEUED)
  startedAt        DateTime             @default(now())
  completedAt      DateTime?
  durationMs       Int?
  summary          String?
  result           Json?
  evaluation       Json?
  correlationId    String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  agent   Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  version AgentVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, agentId, sourceEntityType, sourceEntityId])
  @@index([workspaceId, status, startedAt])
  @@index([agentId, startedAt])
  @@index([versionId])
  @@index([leadId])
  @@index([correlationId])
}

model WorkspaceMember {
  id          String                @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  status      WorkspaceMemberStatus @default(ACTIVE)
  joinedAt    DateTime              @default(now())
  invitedById String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId, status])
  @@index([workspaceId, role, status])
}

model DomainEventOutbox {
  workspaceId            String?
  id                     String              @id @default(cuid())
  eventType              String
  aggregateType          String
  aggregateId            String
  payload                Json
  status                 DomainEventStatus   @default(PENDING)
  priority               DomainEventPriority @default(NORMAL)
  correlationId          String
  idempotencyKey         String              @unique
  attempts               Int                 @default(0)
  maxAttempts            Int                 @default(5)
  nextAttemptAt          DateTime            @default(now())
  queueName              String?
  queueJobId             String?
  queuedAt               DateTime?
  lockedAt               DateTime?
  lockedBy               String?
  processedAt            DateTime?
  failedAt               DateTime?
  deadLetteredAt         DateTime?
  lastErrorCode          String?
  lastErrorMessage       String?
  retryRequestedByUserId String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  retryRequestedBy User? @relation("DomainEventRetryRequestedBy", fields: [retryRequestedByUserId], references: [id], onDelete: SetNull)

  @@index([eventType])
  @@index([aggregateType, aggregateId])
  @@index([status, nextAttemptAt])
  @@index([queueName, queueJobId])
  @@index([correlationId])
  @@index([priority])
  @@index([queuedAt])
  @@index([lockedAt])
  @@index([processedAt])
  @@index([failedAt])
  @@index([deadLetteredAt])
  @@index([retryRequestedByUserId])
  @@index([createdAt])
}

model KnowledgeBaseEntry {
  id              String                @id @default(cuid())
  key             String                @unique
  title           String
  category        KnowledgeBaseCategory
  status          KnowledgeBaseStatus   @default(DRAFT)
  activeVersionId String?
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  createdBy User?                  @relation("KnowledgeEntryCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy User?                  @relation("KnowledgeEntryUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  versions  KnowledgeBaseVersion[]

  @@index([category])
  @@index([status])
  @@index([activeVersionId])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@index([createdAt])
}

model KnowledgeBaseVersion {
  id                    String    @id @default(cuid())
  entryId               String
  version               Int
  content               String
  sourceTitle           String
  sourceUrl             String?
  sourceType            String
  correctionOfVersionId String?
  createdByUserId       String?
  approvedByUserId      String?
  approvedAt            DateTime?
  createdAt             DateTime  @default(now())

  entry               KnowledgeBaseEntry     @relation(fields: [entryId], references: [id], onDelete: Restrict)
  correctionOfVersion KnowledgeBaseVersion?  @relation("KnowledgeVersionCorrection", fields: [correctionOfVersionId], references: [id], onDelete: SetNull)
  corrections         KnowledgeBaseVersion[] @relation("KnowledgeVersionCorrection")
  createdBy           User?                  @relation("KnowledgeVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  approvedBy          User?                  @relation("KnowledgeVersionApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@unique([entryId, version])
  @@index([entryId])
  @@index([correctionOfVersionId])
  @@index([createdByUserId])
  @@index([approvedByUserId])
  @@index([approvedAt])
  @@index([createdAt])
}

model ScoringConfig {
  id                String   @id @default(cuid())
  key               String   @unique @default("default")
  requirementWeight Int      @default(20)
  authorityWeight   Int      @default(20)
  budgetWeight      Int      @default(20)
  timelineWeight    Int      @default(20)
  businessFitWeight Int      @default(20)
  warmThreshold     Int      @default(60)
  hotThreshold      Int      @default(80)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([key])
}

model AuthSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Company {
  id                String   @id @default(cuid())
  workspaceId       String?
  name              String
  website           String?
  normalizedWebsite String?  @unique
  industry          String?
  location          String?
  employeeRange     String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  contacts Contact[]
  leads    Lead[]

  @@index([name])
  @@index([website])
  @@index([normalizedWebsite])
  @@index([workspaceId, name])
}

model Contact {
  id               String   @id @default(cuid())
  workspaceId      String?
  companyId        String
  firstName        String
  lastName         String
  title            String?
  email            String?
  normalizedEmail  String?
  phone            String?
  normalizedPhone  String?
  whatsappId       String?
  source           String?
  preferredChannel String?
  doNotContact     Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company                  Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  leads                    Lead[]
  outboundEmails           OutboundEmail[]
  outboundWhatsAppMessages OutboundWhatsAppMessage[]
  inboundEmails            InboundEmail[]
  followUpSequences        FollowUpSequence[]
  callingSequences         CallingSequence[]
  callingAttempts          CallingAttempt[]
  meetingRequests          MeetingRequest[]
  voiceCallAttempts        VoiceCallAttempt[]

  @@unique([companyId, normalizedEmail])
  @@unique([companyId, normalizedPhone])
  @@unique([companyId, whatsappId])
  @@index([companyId])
  @@index([normalizedEmail])
  @@index([normalizedPhone])
  @@index([whatsappId])
  @@index([doNotContact])
  @@index([workspaceId, companyId])
}

model Pipeline {
  id          String         @id @default(cuid())
  workspaceId String
  name        String
  type        String         @default("SALES")
  isDefault   Boolean        @default(false)
  status      PipelineStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages    PipelineStage[]
  deals     Deal[]

  @@unique([workspaceId, name])
  @@index([workspaceId, status])
}

model PipelineStage {
  id          String              @id @default(cuid())
  workspaceId String?
  pipelineId  String?
  key         String              @unique
  semanticKey String?
  label       String
  order       Int                 @unique
  position    Int                 @default(0)
  probability Int
  color       String?
  status      PipelineStageStatus @default(ACTIVE)
  isClosed    Boolean             @default(false)
  isWon       Boolean             @default(false)
  isLost      Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  pipeline Pipeline? @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  leads    Lead[]
  deals    Deal[]

  @@unique([pipelineId, semanticKey])
  @@index([isClosed])
  @@index([workspaceId, order])
  @@index([pipelineId, position])
}

model Lead {
  id                    String          @id @default(cuid())
  workspaceId           String?
  companyId             String
  contactId             String
  ownerId               String?
  source                String
  status                LeadStatus      @default(OPEN)
  stageId               String
  requirement           String?
  serviceInterest       String?
  score                 Int             @default(0)
  temperature           LeadTemperature @default(NURTURE)
  scoreOverrideAt       DateTime?
  scoreOverrideByUserId String?
  scoreOverrideReason   String?
  estimatedValue        Decimal?        @db.Decimal(12, 2)
  currency              String          @default("INR")
  nextAction            String?
  nextActionAt          DateTime?
  lastActivityAt        DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  company                  Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contact                  Contact                   @relation(fields: [contactId], references: [id], onDelete: Restrict)
  owner                    User?                     @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  scoreOverrideBy          User?                     @relation("LeadScoreOverrideBy", fields: [scoreOverrideByUserId], references: [id], onDelete: SetNull)
  stage                    PipelineStage             @relation(fields: [stageId], references: [id], onDelete: Restrict)
  deal                     Deal?
  qualification            LeadQualification?
  activities               Activity[]
  conversations            Conversation[]
  outboundEmails           OutboundEmail[]
  inboundEmails            InboundEmail[]
  followUpSequences        FollowUpSequence[]
  followUpAttempts         FollowUpAttempt[]
  callingSequences         CallingSequence[]
  callingAttempts          CallingAttempt[]
  humanTakeovers           HumanTakeover[]
  scoreRuns                LeadScoreRun[]
  replyProcessingRuns      ReplyProcessingRun[]
  negotiationHandoffs      NegotiationHandoff[]
  internalNotifications    InternalNotification[]
  proposals                Proposal[]
  proposalGenerationRuns   ProposalGenerationRun[]
  agentCorrections         AgentCorrection[]
  meetingRequests          MeetingRequest[]
  voiceCallAttempts        VoiceCallAttempt[]
  voiceConversationRuns    VoiceConversationRun[]
  outboundWhatsAppMessages OutboundWhatsAppMessage[]
  briefingRuns             BriefingRun[]
  tasks                    Task[]

  @@index([companyId])
